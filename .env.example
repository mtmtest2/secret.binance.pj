# ===========================================================================
# AI Quant Trading System — configuration
#
#   cp .env.example .env
#
# Every line below is OPTIONAL: each one just restates the built-in default,
# so an empty .env (or no .env at all) runs fine. Uncomment/change only what
# you actually want to override.
#
# RULES
#   * Nested settings use a DOUBLE underscore:  GROUP__FIELD=value
#   * Put comments on their OWN line. An inline comment after an EMPTY value
#     is parsed as the value itself, which silently breaks that setting.
#         BAD :  WEB__API_TOKEN=        # my note
#         GOOD:  # my note
#                WEB__API_TOKEN=
#   * Booleans: true / false. Percentages are fractions (0.05 == 5 %).
#   * Never commit your real .env — it is already in .gitignore.
# ===========================================================================


# ---------------------------------------------------------------------------
# GLOBAL
# ---------------------------------------------------------------------------
# backtest | paper | live. This is only the STARTING engine; you switch modes
# from the web panel. Trading is never armed automatically (see below).
TRADING_MODE=paper

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# SINGLE-RUN AUTOMATION
# `python main.py` binds the panel, then collects data and trains by itself.
# ---------------------------------------------------------------------------
# Run data collection + training automatically at startup.
AUTO_SETUP_ON_START=true

# Train missing/stale models as part of auto-setup.
AUTO_TRAIN=true

# Arm paper trading the moment setup finishes. Leave false to arm it yourself
# from the panel — that is the safe default and the recommended workflow.
AUTOSTART_PAPER_TRADING=false


# ---------------------------------------------------------------------------
# UNIVERSE SCREENING
# The pairs themselves are ticked in the web panel, not listed here. These
# thresholds only decide which pairs the panel marks eligible.
# ---------------------------------------------------------------------------
# How many pairs the "Suggest" button pre-selects.
UNIVERSE__TARGET_COUNT=30

# Liquidity floor: 24 h quote volume in USDT.
UNIVERSE__MIN_QUOTE_VOLUME_24H=50000000

# Bid/ask spread ceiling in basis points (paid on every 5m round trip).
UNIVERSE__MAX_SPREAD_BPS=6

# Minimum days since listing — below this there is too little 5m history.
UNIVERSE__MIN_HISTORY_DAYS=365

# >>> SET THIS TO YOUR REAL ACCOUNT SIZE <<<
# The small-capital screen is calibrated against this equity. Pairs whose
# exchange minimum or lot-size step is too large to size a position at this
# account size are flagged ineligible. This is what rejects BTC on a small
# account: a 0.001 BTC step is ~95 USDT of notional.
UNIVERSE__REFERENCE_EQUITY=1000

# One lot step must not cost more than this share of the smallest position.
UNIVERSE__MAX_GRANULARITY_FRACTION=0.25


# ---------------------------------------------------------------------------
# EXCHANGE
# Leave the keys blank for backtest/paper — public market data needs no auth.
# ---------------------------------------------------------------------------
EXCHANGE__API_KEY=
EXCHANGE__API_SECRET=

# true  -> futures TESTNET (testnet.binancefuture.com)
# false -> REAL MONEY on mainnet. Only flip this when you mean it.
EXCHANGE__TESTNET=true

EXCHANGE__MAX_RETRIES=5
EXCHANGE__BACKOFF_BASE_SECONDS=1.0
EXCHANGE__BACKOFF_MAX_SECONDS=60.0

# Raise cautiously: this is the main lever on Binance IP weight usage.
EXCHANGE__MAX_CONCURRENT_REQUESTS=8


# ---------------------------------------------------------------------------
# DATA PIPELINE
# ---------------------------------------------------------------------------
# Candles per request page (Binance caps klines at 1500).
DATA__OHLCV_LIMIT=1500

# History depth backfilled per symbol. 105120 x 5m ~= 365 days.
# Raise for a richer training set; bootstrap takes proportionally longer.
DATA__HISTORY_BOOTSTRAP_CANDLES=105120

DATA__ORDERBOOK_DEPTH=20

# Seconds after each 5m boundary at which the cycle fires. Firing at exactly
# :00 races the exchange's own candle close and drops the last bar.
DATA__CYCLE_SECOND_OFFSET=10


# ---------------------------------------------------------------------------
# QUALITY CONTROL
# ---------------------------------------------------------------------------
QC__MAX_HEAL_ATTEMPTS=4

# Reject any candle moving more than this in a single 5m bar (0.35 == 35 %).
QC__MAX_ABS_CANDLE_RETURN=0.35

# Flag volume above median x this as a probable API glitch.
QC__VOLUME_SPIKE_MEDIAN_MULTIPLE=50

# Robust (MAD-based) sigma threshold for return outliers.
QC__RETURN_MAD_ZSCORE_LIMIT=14


# ---------------------------------------------------------------------------
# DECISION ENGINE
# The rule cascade. Loosening these is the fastest way to make the system
# trade more — and the fastest way to make it lose money.
# ---------------------------------------------------------------------------
# Rule R1: minimum directional probability mass to consider a trade.
DECISION__MIN_DIRECTION_CONFIDENCE=0.70

# Rule R2: required edge over the opposing direction.
DECISION__MIN_DIRECTION_MARGIN=0.15

# Rule R4: entry-model probability required to act on THIS candle.
DECISION__MIN_ENTRY_PROBABILITY=0.55

# Rule R5: reject geometry below this reward/risk ratio.
DECISION__MIN_REWARD_RISK_RATIO=1.3

# Hard ceiling; also enforced by schema validation at 10.
DECISION__MAX_LEVERAGE=10
DECISION__MIN_LEVERAGE=1

# Fraction of equity committed as margin per position.
DECISION__MIN_CAPITAL_ALLOCATION_PCT=0.01
DECISION__MAX_CAPITAL_ALLOCATION_PCT=0.20

DECISION__MAX_CONCURRENT_POSITIONS=5

# Suspend trading above this rolling GARCH volatility percentile.
DECISION__MAX_VOLATILITY_PERCENTILE=0.97


# ---------------------------------------------------------------------------
# RISK GUARD / KILL SWITCH
# ---------------------------------------------------------------------------
# Reference equity for the guard's drawdown maths.
RISK__STARTING_EQUITY=1000

# RED = halt everything, flatten, require a manual reset.
RISK__DAILY_DRAWDOWN_RED_PCT=0.05

# YELLOW = keep trading at reduced size.
RISK__DAILY_DRAWDOWN_YELLOW_PCT=0.03

# Peak-to-trough halt.
RISK__TOTAL_DRAWDOWN_RED_PCT=0.20

RISK__CONSECUTIVE_LOSSES_YELLOW=3
RISK__CONSECUTIVE_LOSSES_RED=5

# Size multiplier applied while in YELLOW.
RISK__YELLOW_SIZE_MULTIPLIER=0.4

RISK__MAX_DAILY_TRADES=40

# Keep true. False lets a drawdown halt clear itself, which defeats the point.
RISK__REQUIRE_MANUAL_RESET=true


# ---------------------------------------------------------------------------
# EXECUTION
# ---------------------------------------------------------------------------
# isolated | cross. Keep isolated: it caps the loss per position at its margin.
EXECUTION__MARGIN_MODE=isolated

# market | limit
EXECUTION__ORDER_TYPE=market

# Binance USDT-M defaults: taker 0.05 %, maker 0.02 %.
EXECUTION__TAKER_FEE=0.0005
EXECUTION__MAKER_FEE=0.0002

# Simulated slippage penalty in bps (paper + backtest).
EXECUTION__SLIPPAGE_BPS=5

# Virtual starting balance for paper trading.
EXECUTION__PAPER_STARTING_BALANCE=1000

# How often open positions are re-priced and trailing stops advanced.
EXECUTION__POSITION_MONITOR_INTERVAL_SECONDS=5


# ---------------------------------------------------------------------------
# MACHINE LEARNING
# ---------------------------------------------------------------------------
# lightgbm | xgboost
ML__BOOSTER=lightgbm

ML__N_ESTIMATORS=400
ML__LEARNING_RATE=0.05
ML__MAX_DEPTH=6

# Tail fraction held out, and bars purged between train and validation so the
# forward-looking labels cannot leak across the split.
ML__VALIDATION_FRACTION=0.2
ML__PURGE_BARS=60


# ---------------------------------------------------------------------------
# FEATURE ENGINEERING
# Lower the windows if bootstrap history is short; raise for more stable
# regime and volatility estimates at the cost of a slower warm-up.
# ---------------------------------------------------------------------------
FEATURES__GARCH_WINDOW=500
FEATURES__GARCH_REFIT_EVERY=50
FEATURES__HMM_STATES=4
FEATURES__HMM_WINDOW=1000
FEATURES__HMM_REFIT_EVERY=100
FEATURES__ATR_WINDOW=14


# ---------------------------------------------------------------------------
# LABELING
# ---------------------------------------------------------------------------
# Take-profit and stop-loss distances as multiples of ATR.
LABELS__TP_ATR_MULTIPLE=2.0
LABELS__SL_ATR_MULTIPLE=1.0

# Bars a simulated trade may stay open (48 x 5m == 4 h).
LABELS__MAX_HOLDING_BARS=48


# ---------------------------------------------------------------------------
# WEB PANEL
# ---------------------------------------------------------------------------
WEB__HOST=0.0.0.0
WEB__PORT=8000

# Shared secret for the mutating /api/* endpoints (kill switch, arm trading,
# save universe). Blank = NO AUTH, which is fine only behind a firewall or an
# SSH tunnel. Set a real value before exposing the port.
# NOTE: keep this line's value on the same line with nothing after it.
WEB__API_TOKEN=


# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Log every SQL statement (very noisy; debugging only).
DB__ECHO=false

# WAL lets the panel read while the trading loop writes. Keep it.
DB__JOURNAL_MODE=WAL
