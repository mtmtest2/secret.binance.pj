# ---------------------------------------------------------------------------
# AI Quant Trading System - example configuration
# Copy to `.env` and edit.  Nested settings use a DOUBLE underscore delimiter.
# ---------------------------------------------------------------------------

# --- Global ----------------------------------------------------------------
TRADING_MODE=paper            # backtest | paper | live
TRADING_ENABLED=true
LOG_LEVEL=INFO

# --- Exchange (leave the keys blank for backtest/paper on public data) ------
EXCHANGE__API_KEY=
EXCHANGE__API_SECRET=
EXCHANGE__TESTNET=true         # set to false ONLY when going live on mainnet
EXCHANGE__MAX_RETRIES=5
EXCHANGE__MAX_CONCURRENT_REQUESTS=8

# --- Data ------------------------------------------------------------------
DATA__OHLCV_LIMIT=500
DATA__HISTORY_BOOTSTRAP_CANDLES=6000
DATA__ORDERBOOK_DEPTH=20
DATA__CYCLE_SECOND_OFFSET=10   # fire the cycle N seconds after the 5m boundary

# --- Quality control -------------------------------------------------------
QC__MAX_HEAL_ATTEMPTS=4
QC__MAX_ABS_CANDLE_RETURN=0.35
QC__VOLUME_SPIKE_MEDIAN_MULTIPLE=50

# --- Decision thresholds ---------------------------------------------------
DECISION__MIN_DIRECTION_CONFIDENCE=0.70
DECISION__MIN_ENTRY_PROBABILITY=0.55
DECISION__MIN_REWARD_RISK_RATIO=1.3
DECISION__MAX_LEVERAGE=10
DECISION__MAX_CONCURRENT_POSITIONS=5
DECISION__MAX_CAPITAL_ALLOCATION_PCT=0.20

# --- Risk guard / kill switch ----------------------------------------------
RISK__STARTING_EQUITY=1000
RISK__DAILY_DRAWDOWN_RED_PCT=0.05
RISK__DAILY_DRAWDOWN_YELLOW_PCT=0.03
RISK__CONSECUTIVE_LOSSES_RED=5
RISK__MAX_DAILY_TRADES=40
RISK__REQUIRE_MANUAL_RESET=true

# --- Execution -------------------------------------------------------------
EXECUTION__MARGIN_MODE=isolated
EXECUTION__ORDER_TYPE=market
EXECUTION__TAKER_FEE=0.0005
EXECUTION__MAKER_FEE=0.0002
EXECUTION__SLIPPAGE_BPS=5
EXECUTION__PAPER_STARTING_BALANCE=1000

# --- Web panel -------------------------------------------------------------
WEB__HOST=0.0.0.0
WEB__PORT=8000
WEB__API_TOKEN=                # set a secret to protect the control endpoints

# --- Database --------------------------------------------------------------
DB__ECHO=false
DB__JOURNAL_MODE=WAL
